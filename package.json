{
  "name": "ssps-schoolwork",
  "version": "0.1.0",
  "description": "Read-only Teams and Bakalari schoolwork context for AI agents",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test browser",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "login:teams": "node --env-file-if-exists=.env dist/cli.js login-teams",
    "import:teams": "node --env-file-if-exists=.env dist/cli.js import-teams",
    "login:bakalari": "node --env-file-if-exists=.env dist/cli.js login-bakalari",
    "doctor": "node --env-file-if-exists=.env dist/cli.js doctor",
    "logout": "node --env-file-if-exists=.env dist/cli.js logout",
    "setup": "node scripts/connection-config.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/msal-node": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
